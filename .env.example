# mick-agentic-browser — copy to .env and fill in.
PORT=3005
PUBLIC_HOST=mick.au.ngrok.io          # what jambonz dials: wss://<PUBLIC_HOST>/harness and /ws
LOG_LEVEL=info
AGENT_NAME=Mick

HARNESS_SECRET=                        # Agent Studio > Custom harness > Secret (Bearer on the upgrade); empty = open
WS_SECRET=                             # conductor /ws token; required on any public host (verbs carry the Gemini key)
HARNESS_CREDENTIAL_LABEL=              # optional jambonz LLM credential (vendor harness) label for the agent verb

# models (OpenAI-compatible endpoint; Gemini by default)
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FAST_MODEL=gemini-3.5-flash-lite       # chit-chat / confirmations
DEEP_MODEL=gemini-3.6-flash            # browsing + transactions (tool loop)
DEEP_MODEL_PARAMS={"reasoning_effort":"low"}
SUMMARY_MODEL=gemini-3.5-flash-lite
BROWSER_VISION=true                    # attach a screenshot to each deep-lane request
MAX_TOOL_ROUNDS=8

# speech-to-speech front (greeting + small talk)
S2S_VENDOR=google
S2S_MODEL=models/gemini-3.8-live
S2S_VOICE=Aoede
S2S_AFFECTIVE=false

# cascaded voice (same voice family as S2S)
TTS_VENDOR=google
TTS_VOICE=en-AU-Chirp3-HD-Aoede
TTS_LANGUAGE=en-AU
TTS_OPTIONS={"apiMode":"live"}
STT_VENDOR=google
STT_LANGUAGE=en-AU
AGENT_TURN_DETECTION=krisp

# jambonz account (REST) — for register-app.mjs, POST /api/calls, route-number.mjs
JAMBONZ_API_KEY=
JAMBONZ_ACCOUNT_SID=
JAMBONZ_API_BASE=https://api.jambonz.cloud
JAMBONZ_APPLICATION_SID=               # printed by scripts/register-app.mjs
JAMBONZ_FROM_NUMBER=
JAMBONZ_SELF_REGISTER=false            # true on a hosted deploy: rewrite the app hooks to this host on boot

# browser
BROWSER_HEADLESS=false                 # headed: log in to sites yourself in that window; the agent reuses the session
BROWSER_PROFILE_DIR=.profile
BROWSER_HOME_URL=https://www.bing.com/
BROWSER_SEARCH_URL=https://www.bing.com/search?q={q}   # Bing works headless; Google/DuckDuckGo block automation
BROWSER_BLOCKED_HOSTS=                 # comma list: every click on these hosts needs a spoken confirmation

# knowledge base
KB_EMBEDDINGS=true                     # Gemini embeddings (gemini-embedding-001, 768d); false = BM25 only
KB_EMBEDDING_MODEL=gemini-embedding-001
KB_EMBEDDING_DIM=768
QDRANT_URL=                            # https://<cluster>.cloud.qdrant.io:6333 or http://localhost:6333; empty = in-process index
QDRANT_API_KEY=
QDRANT_SOPS_COLLECTION=mab_sops
QDRANT_KNOWLEDGE_COLLECTION=mab_knowledge
KB_TOP_K=3

# observability
UPSTASH_REDIS_REST_URL=                # https://<name>.upstash.io ; empty = in-memory only
UPSTASH_REDIS_REST_TOKEN=
OBS_TTL_SECONDS=1209600

# tasks over SMS / WhatsApp (Instinct-style: message Aria, no app)
# Inbound: point the Twilio number's / WhatsApp sandbox's "A MESSAGE COMES IN" webhook at
#   https://<PUBLIC_HOST>/webhooks/message  — only OWNER_PHONE is accepted; unset = inbound off.
# Outbound: Aria's task replies are sent with the Twilio REST creds below; without them every
#   send is a logged dry-run (safe to develop against).
OWNER_PHONE=                           # your own mobile in E.164 (+614…): the only accepted sender + where updates go
TASK_NOTIFY=                           # whatsapp | sms | empty — forward EVERY Aria task reply to your phone
TWILIO_ACCOUNT_SID=                    # Twilio Console → Account Info
TWILIO_AUTH_TOKEN=                     # also used to verify webhook signatures
TWILIO_WHATSAPP_FROM=+14155238886      # Twilio WhatsApp SANDBOX number (join it once from your phone); replace after registering a real sender
SMS_FROM=+18558713724                  # the account's only SMS-capable sender (same default as the MCP SMS path)

# atmosphere under the call (jambonz dub tracks, served from /public/audio via PUBLIC_HOST)
AMBIENCE_ENABLED=true
AMBIENCE_BED_GAIN=-30 dB                # room tone, whole call
AMBIENCE_TYPING_GAIN=-20 dB             # keyboard clatter while a specialist works the browser
AMBIENCE_HOLD_GAIN=-16 dB               # warm pad on the caller's leg while an outbound call is made for them
# regenerate the loops: node scripts/make-audio.mjs (ambience.wav, typing.wav, hold.wav)
